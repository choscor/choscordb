QTabWidget::pane {
  border: 0;
}

QTabBar {
  background: @surface-raised;
  border-radius: 0;
  border-bottom: 1px solid @border;
}

QTabBar[designTabVariant="document"] {
  border: 0;
}

QTabBar::tab {
  min-height: @pane-tab-height;
  max-height: @pane-tab-height;
  border: 0;
  border-bottom: 2px solid transparent;
  border-radius: 0;
  padding: 0 9px;
  margin: 0 0 1px 0;
  font-size: @font-small;
  color: @fg-muted;
  background: transparent;
}

QTabBar::tab:first, QTabBar::tab:only-one {
  margin-left: 9px;
}

QTabBar::tab:last, QTabBar::tab:only-one {
  margin-right: 9px;
}

QTabBar::tab:selected {
  background: @surface;
  color: @fg;
  border-bottom-color: @fg-muted;
}

QTabBar[designTabVariant="document"]::tab {
  min-width: @document-tab-width;
  max-width: @document-tab-width;
  min-height: @document-tab-height;
  max-height: @document-tab-height;
  border-bottom: 0;
  border-top: 2px solid transparent;
  border-right: 1px solid @border;
  padding: 0 12px 0 8px;
  margin: 0;
}

QTabBar[designTabVariant="document"]::tab:selected {
  border-top-color: @fg-muted;
  font-weight: bold;
}

QTabBar::tab:hover {
  color: @fg;
}

QTabBar::tab:disabled {
  color: @fg-disabled;
}
