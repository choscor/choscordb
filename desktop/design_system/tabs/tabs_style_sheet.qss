QTabWidget::pane {
  border: 0;
}

QTabWidget[designTabVariant="pane"]::tab-bar {
  alignment: left;
  left: @space-2;
}

QTabBar {
  background: @kumo-recessed;
  border: 0;
  border-radius: @radius-lg;
  font-size: @font-body;
  font-weight: 500;
}

QTabBar[designTabVariant="document"] {
  background: @kumo-base;
  border-radius: 0;
}

QTabBar::tab {
  min-height: @pane-tab-height;
  max-height: @pane-tab-height;
  border: 1px solid transparent;
  border-radius: @radius-md;
  padding: 0 @space-2-5;
  margin: @space-half 0;
  color: @text-kumo-subtle;
  background: transparent;
}

QTabBar::tab:first, QTabBar::tab:only-one {
  margin-left: @space-half;
}

QTabBar::tab:last, QTabBar::tab:only-one {
  margin-right: @space-half;
}

QTabBar::tab:selected {
  background: @kumo-base;
  border-color: @kumo-line;
  color: @text-kumo-default;
}

QTabBar[designTabVariant="document"]::tab {
  min-width: @document-tab-width;
  max-width: @document-tab-width;
  min-height: @document-tab-height;
  max-height: @document-tab-height;
  border: 0;
  border-bottom: @focus-width solid transparent;
  border-radius: 0;
  padding: 0 @space-3 0 @space-2;
  margin: 0;
}

QTabBar[designTabVariant="document"]::tab:selected {
  border-bottom-color: @kumo-brand;
}

QTabBar[designTabVariant="document"]::tab:hover {
  background: @kumo-tint;
}

QTabBar::tab:hover {
  color: @text-kumo-default;
}

QTabBar::tab:disabled {
  color: @text-kumo-inactive;
}
