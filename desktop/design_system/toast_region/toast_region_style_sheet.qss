QLabel#toastRegion, QLabel#progressToast {
  background-color: @kumo-base;
  color: @text-kumo-default;
  border: 1px solid @kumo-line;
  border-radius: @radius-xl;
  padding: 0;
}

QLabel#toastRegion[variant="success"] {
  background-color: @toast-success-fill;
  border-color: @toast-success-ring;
}

QLabel#toastRegion[variant="warning"] {
  background-color: @toast-warning-fill;
  border-color: @toast-warning-ring;
}

QLabel#toastRegion[variant="danger"] {
  background-color: @toast-danger-fill;
  border-color: @toast-danger-ring;
}

QProgressBar#toastProgress {
  min-height: @space-2;
  max-height: @space-2;
  border-radius: @radius-sm;
}

QProgressBar#toastProgress::chunk {
  border-radius: @radius-sm;
}
