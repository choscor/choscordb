QLabel#toastRegion, QLabel#progressToast {
  background-color: @surface-raised;
  color: @fg-muted;
  border: 1px solid @border;
  border-radius: @radius-md;
  padding: @space-2;
}

QLabel#toastRegion[variant="success"] {
  background-color: @success-surface;
  color: @success;
}

QLabel#toastRegion[variant="warning"] {
  background-color: @warning-surface;
  color: @warning;
}

QLabel#toastRegion[variant="danger"] {
  background-color: @danger-surface;
  color: @danger;
}

QLabel#toastRegion[variant="progress"], QLabel#progressToast[variant="progress"] {
  padding-top: @space-1;
}

QProgressBar#toastProgress {
  min-height: @space-2;
  max-height: @space-2;
  border-radius: @radius-sm;
}

QProgressBar#toastProgress::chunk {
  border-radius: @radius-sm;
}

QToolButton#toastDismiss {
  min-width: 24px;
  max-width: 24px;
  min-height: 24px;
  max-height: 24px;
  padding: 0;
  border: 1px solid transparent;
  border-radius: @radius-sm;
  background: transparent;
}

QToolButton#toastDismiss:hover {
  background: @border;
}

QToolButton#toastDismiss:focus {
  border-color: @ring;
}
