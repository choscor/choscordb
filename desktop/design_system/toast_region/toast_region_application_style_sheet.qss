QLabel#toastRegion, QLabel#progressToast {
  background-color: @warningSurface;
  color: %17;
  border: %2px solid %3;
  border-radius: %16px;
  padding: %5px;
}

QLabel#toastRegion[variant="success"] {
  background-color: @success;
  color: @successForeground;
}

QLabel#toastRegion[variant="warning"] {
  background-color: @warningSurface;
}

QLabel#toastRegion[variant="danger"] {
  background-color: @dangerSurface;
}

QLabel#toastRegion[variant="progress"], QLabel#progressToast[variant="progress"] {
  background-color: @warningSurface;
  padding-top: @toastProgressTopPadding;
}

QProgressBar#toastProgress {
  min-height: @toastProgressHeight;
  max-height: @toastProgressHeight;
  border-radius: @toastProgressRadius;
}

QProgressBar#toastProgress::chunk {
  border-radius: @toastProgressRadius;
}

QToolButton#toastDismiss {
  min-width: 24px;
  max-width: 24px;
  min-height: 24px;
  max-height: 24px;
  padding: 0;
  border: 1px solid transparent;
  border-radius: 4px;
  background: transparent;
}

QToolButton#toastDismiss:hover {
  background: %12;
}

QToolButton#toastDismiss:focus {
  border-color: %7;
}
