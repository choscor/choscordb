QLabel#toastRegion {
  background-color: %18;
  color: %17;
  border: %2px solid %3;
  border-radius: %16px;
  padding: %5px;
}

QLabel#toastRegion[variant="success"] {
  background-color: @successSurface;
  border-left: 4px solid %19;
}

QLabel#toastRegion[variant="warning"] {
  background-color: @warningSurface;
  border-left: 4px solid %20;
}

QLabel#toastRegion[variant="danger"] {
  background-color: @dangerSurface;
  border-left: 4px solid %21;
}
