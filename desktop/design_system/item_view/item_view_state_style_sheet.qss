QTableView::item:selected, QListView::item:selected {
  background: @selection;
  color: @fg;
}

QTableView::item:hover:!selected, QListView::item:hover:!selected {
  background: @surface-raised;
}

QListView[designSurface="sidebar"]::item:selected {
  background: @sidebar-selection;
  border-radius: @radius-md;
}

QListView[designSurface="sidebar"]::item:hover:!selected {
  background: @sidebar-hover;
  color: @fg;
  border-radius: @radius-md;
}
