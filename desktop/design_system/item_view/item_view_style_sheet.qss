QWidget[designSurface="subtle"] {
  background: @selection;
}

QWidget[designSurface="sidebar"] {
  background: @sidebar;
}

/* A softly layered navigator surface, shared by all three sidebar panes. */
QWidget#navigatorBody {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                              stop:0 @sidebar-glass-top, stop:0.56 @sidebar-glass-top,
                              stop:1 @sidebar-glass-bottom);
  border-right: 1px solid @border;
}

QWidget#navigatorBody QStackedWidget,
QWidget#navigatorBody QWidget#connectionsPanel,
QWidget#navigatorBody QWidget#savedPanel,
QWidget#navigatorBody QWidget#historyPanel,
QTreeView#databaseNavigator,
QTreeView#pinnedList,
QListView[designNavigationItem="true"],
QTreeWidget#sidebarSavedFiles,
QListWidget#savedConnections,
QListWidget#sidebarHistoryItems {
  background: transparent;
}

QWidget[designSurface="panel"] {
  background: @surface;
}

QWidget[designSurface="muted"] {
  background: @surface-raised;
}

QTableView, QTreeView, QListView {
  background: @surface;
  alternate-background-color: @surface-raised;
  color: @fg;
  border: 0;
  gridline-color: @border;
  selection-background-color: @selection;
  selection-color: @fg;
  outline: 0;
}
