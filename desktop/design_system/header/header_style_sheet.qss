QHeaderView {
  background: @background;
  color: @foreground;
}

QHeaderView::section {
  min-height: @tableHeaderHeight;
  border: 0;
  border-bottom: 1px solid @border;
  padding: 0 12px;
  background: @muted;
  color: @mutedText;
  font-size: 11px;
  font-weight: 500;
}

QTableCornerButton::section {
  border: 0;
  border-bottom: 1px solid @border;
  background: @background;
}
