QPushButton {
  min-height: @control-height;
  padding: 0 @space-3;
  border: 1px solid @kumo-line;
  border-radius: @radius-lg;
  background: @kumo-base;
  color: @text-kumo-default;
  font-weight: 500;
}

QPushButton:hover, QPushButton:pressed {
  background-color: @kumo-tint;
}

QPushButton:checked, QPushButton:checked:hover {
  color: @text-kumo-default;
  background-color: @kumo-tint;
  border-color: @kumo-line;
}

QPushButton:default, QPushButton[primary="true"], QToolButton[primary="true"], QPushButton[variant="default"] {
  color: @white;
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 @button-emphasis-brand-start, stop: 1 @button-emphasis-brand-end);
  border-color: @button-emphasis-brand-ring;
}

QPushButton:default:hover, QPushButton[primary="true"]:hover, QPushButton[variant="default"]:hover,
QPushButton:default:pressed, QPushButton[primary="true"]:pressed, QPushButton[variant="default"]:pressed {
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 @button-emphasis-brand-bg, stop: 1 @button-emphasis-brand-end);
}

QPushButton[variant="outline"] {
  background: transparent;
  color: @text-kumo-default;
  border-color: @kumo-line;
}

QPushButton[variant="outline"]:hover, QPushButton[variant="outline"]:pressed {
  background: transparent;
  color: @text-kumo-strong;
}

QPushButton[variant="destructive"] {
  color: @white;
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 @button-emphasis-danger-start, stop: 1 @button-emphasis-danger-end);
  border-color: @button-emphasis-danger-ring;
}

QPushButton[variant="destructive"]:hover, QPushButton[variant="destructive"]:pressed {
  background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1, stop: 0 @button-emphasis-danger-bg, stop: 1 @button-emphasis-danger-end);
}

QPushButton:disabled, QPushButton:default:disabled, QPushButton[primary="true"]:disabled, QPushButton[variant]:disabled {
  color: @text-kumo-inactive;
}
