QListWidget#quickSearchResults {
  background: transparent;
  border: none;
  outline: none;
  color: @fg;
}
QListWidget#quickSearchResults::item {
  border-radius: @radius-md;
  padding: 4px 8px;
  margin: 1px 0;
}
QListWidget#quickSearchResults::item:hover:!selected {
  background: @surface-raised;
}
QListWidget#quickSearchResults::item:selected {
  background: @selection;
  color: @fg;
}
QLabel#quickSearchStatus {
  color: @fg-muted;
}
QLabel#quickSearchStatus[state="error"] {
  color: @danger;
}
