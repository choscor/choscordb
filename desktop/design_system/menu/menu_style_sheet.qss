QMenu {
  margin: @shadow-margin;
  background: @kumo-control;
  color: @text-kumo-default;
  border: 1px solid @kumo-line;
  border-radius: @radius-lg;
  padding: @space-1-5;
  font-size: @font-body;
}

QMenu::item {
  min-width: @menu-item-width;
  height: @menu-row-height;
  padding: 0 @space-6 0 @space-2;
  border-radius: @radius-md;
  font-size: @font-body;
  font-weight: @font-body-weight;
}

QMenu::item:selected {
  background: @kumo-tint;
  color: @text-kumo-default;
}

QMenu::item:disabled {
  color: @text-kumo-inactive;
}

QMenu::separator {
  height: 1px;
  background: @kumo-hairline;
  margin: @space-1 0;
}

QMenu::indicator {
  width: @icon-size;
  height: @icon-size;
}
