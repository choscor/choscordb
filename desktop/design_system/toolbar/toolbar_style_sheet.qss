QToolBar {
  min-height: @toolbar-height;
  spacing: @space-1;
  border: 0;
  background: @bg;
}

QToolBar[designToolbarVariant="workspace"] {
  background: transparent;
}

QWidget[designToolbarSurface="workspace"] {
  background: @surface-raised;
}

QToolBar::separator {
  background: @border;
  width: 1px;
  margin: 4px;
}
