QToolBar {
  min-height: @toolbar-height;
  spacing: @space-1;
  border: 0;
  background: @kumo-canvas;
}

QToolBar[designToolbarVariant="workspace"] {
  background: transparent;
}

QWidget[designToolbarSurface="workspace"] {
  background: @kumo-base;
}

QToolBar::separator {
  background: @kumo-hairline;
  width: 1px;
  margin: @space-1;
}
