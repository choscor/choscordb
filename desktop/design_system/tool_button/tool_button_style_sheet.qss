QToolButton {
  icon-size: 12px;
  min-height: @tool-height;
  max-height: @tool-height;
  border: 1px solid transparent;
  border-radius: @radius-md;
  padding: 0 9px;
  font-size: @font-small;
  background: transparent;
  color: @fg;
}

QToolButton[iconOnly="true"] {
  min-width: 30px;
  max-width: 30px;
  padding: 0;
}

QToolButton:hover, QToolButton:checked {
  background: @surface-raised;
  color: @fg;
}

QToolButton:pressed {
  background: @surface-raised;
  color: @fg;
}

QToolButton:disabled {
  color: @fg-disabled;
}

QToolButton[designRole="menuButton"] {
  padding-right: 21px;
  background: @surface;
}

QToolButton[designRole="menuButton"]:hover, QToolButton[designRole="menuButton"]:pressed, QToolButton[designRole="menuButton"]:checked {
  background: @surface-raised;
}

QToolButton[designRole="menuButton"]::menu-indicator {
  width: 8px;
  height: 8px;
  subcontrol-origin: padding;
  subcontrol-position: right center;
  right: 9px;
}
