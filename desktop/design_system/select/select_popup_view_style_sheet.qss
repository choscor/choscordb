QAbstractItemView {
  border: 1px solid @kumo-line;
  background: @kumo-control;
  color: @text-kumo-default;
  outline: 0;
  padding: @space-1-5;
  border-radius: @radius-lg;
  selection-background-color: @kumo-tint;
  selection-color: @text-kumo-default;
}
QAbstractItemView::item {
  height: @menu-row-height;
  padding: 0 @space-2;
  border: 0;
  border-radius: @radius-sm;
}
QAbstractItemView::item:selected, QAbstractItemView::item:hover {
  background: @kumo-tint;
  color: @text-kumo-default;
}
QAbstractItemView::item:disabled {
  color: @text-kumo-inactive;
}
