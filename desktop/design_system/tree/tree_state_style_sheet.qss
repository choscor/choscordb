QTreeView::item:hover {
  background: @surface-raised;
}

QTreeView::item:selected {
  background: @selection;
  color: @fg;
}

/* On the gray sidebar, hover and selection lift to surface, like a selected tab. */
QTreeView[designSurface="sidebar"]::item:hover,
QTreeView[designSurface="sidebar"]::item:selected {
  background: @surface;
}

/* NavigationTreeView paints its own rounded row fill. */
QTreeView[designNavigationTree="true"]::item:selected {
  background: transparent;
  color: @fg;
}

QTreeView[designNavigationTree="true"]::item:hover {
  background: transparent;
}
