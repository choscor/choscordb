QTreeView::item:hover {
  background: @surface-raised;
}

QTreeView::item:selected {
  background: @selection;
  color: @fg;
}

/* NavigationTreeView paints its own rounded row fill. */
QTreeView[designNavigationTree="true"]::item:selected {
  background: transparent;
  color: @fg;
}

QTreeView[designNavigationTree="true"]::item:hover {
  background: transparent;
}
