QTreeView::item:hover:!selected {
  background: @kumo-tint;
}

QTreeView::item:selected {
  background: @kumo-tint;
  color: @text-kumo-default;
}

QTreeView::item:selected:!active {
  background: @kumo-tint;
}

QTreeView::item:selected:hover {
  background: @kumo-tint;
}

QTreeView[designSurface="sidebar"]::item:hover:!selected {
  background: @kumo-tint;
}

QTreeView[designSurface="sidebar"]::item:selected {
  background: @kumo-tint;
}

QTreeView[designSurface="sidebar"]::item:selected:hover {
  background: @kumo-tint;
}

QTreeView[designNavigationTree="true"]::item:selected,
QTreeView[designNavigationTree="true"]::item:selected:hover,
QTreeView[designNavigationTree="true"]::item:selected:!active {
  background: transparent;
  color: @text-kumo-default;
}

QTreeView[designNavigationTree="true"]::item:hover,
QTreeView[designNavigationTree="true"]::item:hover:!selected {
  background: transparent;
}
