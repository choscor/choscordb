QLabel[designRole="badge"] {
  min-height: @badge-height;
  max-height: @badge-height;
  border: 1px solid transparent;
  border-radius: @badge-radius;
  padding: 0 @space-2;
  font-size: @font-caption;
  font-weight: @font-caption-weight;
  color: @text-kumo-badge-inverted;
  background: @kumo-badge-inverted;
}

QLabel[designRole="badge"][variant="secondary"] {
  background: @kumo-fill;
  color: @text-kumo-badge-neutral-subtle;
}

QLabel[designRole="badge"][variant="outline"] {
  background: @kumo-base;
  color: @text-kumo-default;
  border-color: @kumo-fill;
}

QLabel[designRole="badge"][variant="error"] {
  background: @kumo-danger-tint;
  color: @text-kumo-danger;
}

QLabel[designRole="badge"][variant="success"] {
  background: @kumo-success-tint;
  color: @text-kumo-success;
}

QLabel[designRole="badge"][variant="warning"] {
  background: @kumo-warning-tint;
  color: @text-kumo-warning;
}
