QLabel[designRole="badge"] {
  min-height: 18px;
  max-height: 18px;
  border: 1px solid transparent;
  border-radius: @radius-sm;
  padding: 0 7px;
  font-size: @font-caption;
  font-weight: 400;
  color: @primary;
  background: @selection;
}

QLabel[designRole="badge"][variant="secondary"] {
  background: @surface-raised;
  color: @fg;
}

QLabel[designRole="badge"][variant="outline"] {
  background: transparent;
  color: @fg;
  border-color: @border;
}

QLabel[designRole="badge"][variant="destructive"] {
  background: @destructive-tint;
  color: @danger;
}

QLabel[designRole="badge"][variant="driver"] {
  background: @surface-raised;
  color: @fg;
  border-color: @border;
}
