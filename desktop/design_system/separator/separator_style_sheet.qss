QFrame[frameShape="4"] {
  max-height: 1px;
  border: 0;
  background: @kumo-hairline;
}

QFrame[frameShape="5"] {
  max-width: 1px;
  border: 0;
  background: @kumo-hairline;
}

QFrame[designRole="toneLine"] {
  min-height: @focus-width;
  max-height: @focus-width;
  border: 0;
  background: transparent;
}

QFrame[designRole="toneLine"][variant="neutral"] {
  background: @text-kumo-subtle;
}

QFrame[designRole="toneLine"][variant="brand"] {
  background: @kumo-brand;
}

QFrame[designRole="toneLine"][variant="success"] {
  background: @text-kumo-success;
}

QFrame[designRole="toneLine"][variant="warning"] {
  background: @text-kumo-warning;
}

QFrame[designRole="toneLine"][variant="danger"] {
  background: @text-kumo-danger;
}
