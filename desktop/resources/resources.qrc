  <qresource prefix="/fonts">
    <file alias="Geist-Regular.ttf">fonts/Geist-Regular.ttf</file>
    <file alias="Geist-Medium.ttf">fonts/Geist-Medium.ttf</file>
    <file alias="Geist-SemiBold.ttf">fonts/Geist-SemiBold.ttf</file>
